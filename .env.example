# --- Local dev (these match the pnpm dev defaults; only set to override) ---
DATABASE_URL=postgres://croft:croft@localhost:5432/croft
# unset in production (defaults to Scaleway fr-par)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=croft-artifacts
S3_ACCESS_KEY=croft
S3_SECRET_KEY=croftcroft
# openssl rand -hex 32 — encrypts stored API keys/tokens
TOKEN_ENC_KEY=
# never set in production
DEV_NO_AUTH=1                              
WEB_URL=http://localhost:3000

# --- GitHub App (needed for PR listing, webhooks, Q&A, comments) ---
GITHUB_APP_ID=
# PEM contents; keep literal newlines or \n-escaped
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- Dashboard login (production; DEV_NO_AUTH=1 bypasses locally) ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# your GitHub username — the only allowed login
DASHBOARD_USER=

# --- Scaleway (production web container only; starts worker jobs) ---
SCW_SECRET_KEY=
SCW_JOB_DEFINITION_ID=

# --- Worker job definition (production) gets per-run env injected: ---
# RUN_ID, PR_NUMBER, PREVIEW_URL (never set these manually except when
# running the worker locally by hand)