{
  "name": "@croft/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "test": "node --import tsx --test src/*.test.ts src/*.test.tsx",
    "test:deployment": "node --import tsx --test tests/deployment.test.ts",
